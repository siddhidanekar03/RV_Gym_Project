# ==============================================================================
# RVFitness Production Multi-Stage Container Packaging
# ==============================================================================
# Builds static React 19 / Vite frontend and packages Python 3.11 FastAPI backend
# with non-root security, healthcheck probe, and reverse-proxy header support.
# ==============================================================================

# Stage 1: Build React 19 / Vite Static Frontend Bundle
FROM node:20-alpine AS frontend-builder
WORKDIR /build

# Copy dependency manifests and install dependencies
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy frontend source and compile static production distribution
COPY frontend/ ./
RUN npm run build

# Stage 2: Python 3.11 FastAPI Production Runtime
FROM python:3.11-slim AS runtime
WORKDIR /app

# Install minimal system runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root unprivileged service account
RUN groupadd -g 10001 rvfitness && \
    useradd -u 10001 -g rvfitness -s /bin/bash -m rvf_user

# Install Python backend dependencies
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

# Copy application source, Alembic migrations, root configuration, and verification tools
COPY backend /app/backend
COPY alembic.ini /app/alembic.ini
COPY scripts /app/scripts

# Copy compiled frontend static bundle from Stage 1 into /app/frontend/dist
COPY --from=frontend-builder /build/dist /app/frontend/dist

# Create persistent storage mount directory for user and announcement media
RUN mkdir -p /app/uploads/announcements && \
    chown -R rvf_user:rvfitness /app/uploads && \
    chmod -R 775 /app/uploads

# Declare persistent volume mount point
VOLUME ["/app/uploads"]

# Expose internal API and static serving port (internal to Docker network)
EXPOSE 8000

# Set Python environment
ENV PYTHONPATH=/app
ENV ENVIRONMENT=production
ENV UPLOADS_DIR=/app/uploads

# Run as unprivileged service account
USER rvf_user

# Healthcheck probe for container orchestrator
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://127.0.0.1:8000/health || exit 1

# Launch Uvicorn with proxy headers enabled for upstream Nginx / ALB ingress
CMD ["python", "-m", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
