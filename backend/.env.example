# RVFitness Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# Application Environment: 'development' | 'test' | 'production'
# In 'production', DATABASE_URL MUST be a PostgreSQL connection string.
ENVIRONMENT=development

# Database Connection URL
# Local Development: sqlite:///./rvfitness_dev.db
# Production: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=sqlite:///./rvfitness_dev.db

# Cryptographic Secret Key for session signing & token verification
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string-in-production

# Allowed CORS Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
