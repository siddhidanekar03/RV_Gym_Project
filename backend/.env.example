# ==============================================================================
# RVFitness Enterprise Gym Management Platform - Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to '.env' and populate with secure, environment-specific values.
# NEVER commit the active '.env' file or genuine cryptographic secrets to version control.
# ==============================================================================

# 1. Operational Environment
# Options: 'development' | 'test' | 'staging' | 'production'
# In 'staging' and 'production', strict security checks are enforced at startup (fail-fast).
ENVIRONMENT=development

# 2. Database Connectivity
# Development: sqlite:///./rvfitness_dev.db
# Production: postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?sslmode=require
DATABASE_URL=sqlite:///./rvfitness_dev.db

# 3. Database Connection Pooling (PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# 4. Cryptographic Secrets
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In production, SECRET_KEY MUST be at least 32 characters of high-entropy randomness.
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string-in-production

# Dedicated QR token signing key (optional; defaults to SECRET_KEY if omitted)
# QR_SIGNING_KEY=change-this-to-a-dedicated-random-64-character-hex-string-in-production

# Session Token Lifetime (in minutes; 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 5. Cookie Security Settings
# COOKIE_SECURE: Set to 'true' in production (HTTPS). Defaults to true when ENVIRONMENT=production.
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SESSION_COOKIE_NAME=rvf_session
CSRF_COOKIE_NAME=rvf_csrf_token

# 6. Network Security & Reverse Proxy
# JSON array of origins permitted for Cross-Origin Resource Sharing. Wildcards ('*') are forbidden in production.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Comma-separated list of trusted upstream reverse-proxy IPs (e.g. Nginx, AWS ALB, Cloudflare)
FORWARDED_ALLOW_IPS=127.0.0.1,::1
TRUSTED_PROXIES=["127.0.0.1","::1"]

# 7. Media & File Upload Storage
# Maximum image size in bytes (default: 5242880 = 5 MB)
MAX_IMAGE_SIZE_BYTES=5242880

# 8. Logging & Diagnostics
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# 9. Email Notification Service (SMTP)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=<smtp_auth_token_placeholder>
# EMAILS_FROM_EMAIL=notifications@rvfitness.in

